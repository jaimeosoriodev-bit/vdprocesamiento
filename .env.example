DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=5432
SCHEMA_NAME=PQRS
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
# NOTA: Los parámetros operativos como OLLAMA_MODEL se priorizan desde la tabla
# relacional "PQRS"."app_config" en PostgreSQL. Si el valor existe en dicha tabla,
# tendrá precedencia sobre la definición en este archivo .env.
OLLAMA_MODEL=qwen3:32b
